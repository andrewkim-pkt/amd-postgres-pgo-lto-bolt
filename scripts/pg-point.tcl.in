# ONE VU point of TPROC-C against PostgreSQL, one hammerdbcli invocation.
# @HOST@ @RAMPUP@ @DURATION@ @TIMEOUT@ @VU@ are filled in by the caller.
# Workload shape held identical to the published PG campaign: allwarehouse true,
# keyandthink false, stored procedures on, timed driver.
dbset db pg
dbset bm TPC-C

diset connection pg_host @HOST@
diset connection pg_port 5432

diset tpcc pg_superuser ec2-user
diset tpcc pg_superuserpass postgres
diset tpcc pg_defaultdbase postgres
diset tpcc pg_user ec2-user
diset tpcc pg_pass postgres
diset tpcc pg_dbase tpcc

diset tpcc pg_driver timed
diset tpcc pg_rampup @RAMPUP@
diset tpcc pg_duration @DURATION@
diset tpcc pg_allwarehouse true
diset tpcc pg_keyandthink false
diset tpcc pg_storedprocs true
diset tpcc pg_timeprofile false

loadscript
puts "@VU@ VU TEST"
vuset vu @VU@
vuset logtotemp 1
vuset unique 1
vuset showoutput 0
vucreate
runtimer @TIMEOUT@
vurun
vudestroy
puts "POINT COMPLETE"
